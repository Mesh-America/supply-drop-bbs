#!/bin/sh
# postinst — Supply Drop BBS Debian post-install script
#
# $1 = "configure"           on a fresh install
# $1 = "configure" $2 = old  on an upgrade from version $2
set -e

case "$1" in
  configure)
    # ── Create the service account if it doesn't already exist ──────────────
    if ! id -u supply-drop >/dev/null 2>&1; then
      useradd \
        --system \
        --no-create-home \
        --shell /sbin/nologin \
        --home-dir /var/lib/supply-drop-bbs \
        --comment "Supply Drop BBS service account" \
        supply-drop
    fi

    # ── Data directory — writeable only by the service account ──────────────
    mkdir -p /var/lib/supply-drop-bbs
    chown supply-drop:supply-drop /var/lib/supply-drop-bbs
    chmod 750 /var/lib/supply-drop-bbs

    # ── Config directory — populated by the setup wizard ────────────────────
    mkdir -p /etc/supply-drop-bbs

    # ── Serial-port access — apply the packaged udev rule ───────────────────
    # 70-supply-drop-bbs.rules re-owns the radio's tty to the `supply-drop`
    # group so the service can open it regardless of the distro's default tty
    # group (dialout vs plugdev). The `supply-drop` group exists by now
    # (created above). Reload + trigger so an already-connected radio picks up
    # the new ownership without needing a replug. Idempotent on upgrades.
    if command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules || true
      udevadm trigger --subsystem-match=tty --action=add || true
    fi

    # ── MeshCore Pi HAT bridge (pymc-companion) self-update ──────────────────
    # /opt/pymc-companion only exists if a HAT was already configured (by
    # install.sh's guided wizard — this package has no standalone path to
    # set one up fresh). On every .deb upgrade, bring an existing bridge's
    # script/unit/dependency current too, mirroring what install.sh's HAT
    # block does, so upgrading via `.deb`/`apt upgrade` alone doesn't leave
    # it silently running stale code forever (see supply-drop-bbs-536 /
    # #243 — this exact gap caused a real production incident: a host
    # upgraded via the documented .deb one-liner kept running the
    # pre-openhop_core pymc-companion.py for hours with no indication
    # anything was wrong).
    #
    # Runs BEFORE supply-drop-bbs.service is (re)started below: the BBS
    # connects out to pymc-companion (Before=supply-drop-bbs.service in
    # pymc-companion.service), so restarting the BBS first and bouncing
    # pymc-companion second would cut the just-reconnected BBS's HAT link
    # again moments later.
    #
    # Wrapped so any failure here is a warning, never a fatal error: a
    # HAT-bridge update problem must not abort the core BBS package
    # install/upgrade transaction. set +e/set -e brackets the subshell so
    # it runs as a bare statement, not as an operand of && or || — POSIX
    # suppresses `set -e` INSIDE a subshell that's part of an AND-OR list
    # at the outer level (a well-known dash/bash gotcha: `(set -e; false;
    # cmd) && ok || fail` still runs `cmd` after the `false`, since the
    # subshell's own errexit gets suppressed too, not just the outer
    # script's). A bare `(set -e; ...)` statement, with the outer script's
    # own errexit temporarily off, correctly stops at the first failing
    # command inside AND doesn't abort the outer postinst script either —
    # verified both properties with a repro before relying on this.
    PYMC_DIR="/opt/pymc-companion"
    PYMC_UNIT="/etc/systemd/system/pymc-companion.service"
    PYMC_SHARE="/usr/share/supply-drop-bbs/pymc-companion"
    PYMC_CONFIG="/etc/supply-drop-bbs/pymc-companion.yaml"
    # Shared with install.sh's HAT block, which takes the same lock around
    # its own venv/pip writes — without it, `apt upgrade` racing a manual
    # `sudo supply-drop-bbs setup` on the same host could run two
    # unsynchronized `pip install`s against the same venv concurrently.
    PYMC_LOCK="$PYMC_DIR/.pymc-companion-update.lock"
    # Pinned (supply-drop-bbs-6zu / #268): this path runs `pip install` as
    # root, unattended, on every future `apt upgrade` of any host with a
    # HAT configured -- unlike install.sh's own openhop-core install (a
    # deliberate, one-time, operator-driven wizard run, which #268 also
    # pins for the same reason but is a smaller window), a floating
    # `--upgrade` here would give a single compromised openhop-core
    # release on PyPI unattended root code execution on every such host's
    # next routine upgrade, no operator action required. Bump this pin
    # deliberately (and install.sh's matching one) after verifying a new
    # release, not as a side effect of any other change.
    OPENHOP_CORE_VERSION="1.1.3"

    if [ -d "$PYMC_DIR" ]; then
      if [ -x "$PYMC_DIR/venv/bin/pip" ]; then
        echo ""
        echo "Detected MeshCore Pi HAT bridge at $PYMC_DIR — updating..."
        set +e
        (
          set -e
          # Non-blocking: if install.sh's HAT setup is running concurrently
          # and already holds the lock, skip this cycle instead of racing
          # it or blocking dpkg's own transaction indefinitely. The next
          # upgrade retries.
          exec 9>"$PYMC_LOCK"
          flock -n 9 || { echo "pymc-companion setup is running concurrently -- skipping this update cycle (will retry next upgrade)." >&2; exit 2; }

          install -m 755 "$PYMC_SHARE/pymc-companion.py" \
            "$PYMC_DIR/pymc-companion.py"
          install -m 644 "$PYMC_SHARE/pymc-companion.service" "$PYMC_UNIT"

          # supply-drop-bbs / #281: adv_type=3 (Room) makes MeshCore
          # companion apps require a protocol-level login handshake this
          # BBS doesn't implement, making it unreachable for any
          # unauthenticated user. #281's fix only changed the code's
          # *default* for a missing key -- it does nothing for a
          # pymc-companion.yaml that already has an explicit `adv_type: 3`
          # line, which is every HAT deployment set up between #100
          # (2026-06-13) and #281 (v1.1.5, 2026-09-11). This is the
          # unattended upgrade path (the documented way to update an
          # existing bridge, per docs/OPERATIONS.md), so it's the one place
          # that actually reaches already-broken installs without the
          # operator having to know to do anything. Unconditional and
          # idempotent (a no-op if already correct, absent, or the file
          # doesn't exist yet) -- adv_type=3 is never a valid choice for
          # this application, not a per-deployment customization to
          # preserve the way radio frequency/region are.
          if [ -f "$PYMC_CONFIG" ] && grep -Eq '^[[:space:]]*adv_type:[[:space:]]*3([[:space:]]|#|$)' "$PYMC_CONFIG"; then
            sed -i 's/^\([[:space:]]*adv_type:[[:space:]]*\)3\([[:space:]]\|$\)/\11\2/' "$PYMC_CONFIG"
            echo "Corrected $PYMC_CONFIG: adv_type 3 (Room) -> 1 (Chat) -- see #281." >&2
          fi

          # timeout bounds a stalled/degraded-network pip against holding
          # dpkg's transaction lock indefinitely on a routine upgrade.
          # Exact pin, not --upgrade -- see OPENHOP_CORE_VERSION's comment
          # above for why (supply-drop-bbs-6zu / #268).
          timeout 60 "$PYMC_DIR/venv/bin/pip" install -q "openhop-core==${OPENHOP_CORE_VERSION}"
          if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload
            systemctl restart pymc-companion.service
            # Type=simple reports `restart` success as soon as the process
            # forks, not once it's actually up -- confirm it didn't
            # immediately crash-loop instead of silently declaring victory.
            sleep 1
            systemctl is-active --quiet pymc-companion.service
          fi
        )
        _pymc_status=$?
        set -e
        case "$_pymc_status" in
          0) echo "pymc-companion updated and restarted." ;;
          2) : ;; # already explained itself above, nothing more to say
          *) echo "Warning: pymc-companion self-update failed -- update it manually (see docs/OPERATIONS.md). The main supply-drop-bbs service is unaffected." >&2 ;;
        esac
        echo ""
      else
        echo ""
        echo "Warning: $PYMC_DIR exists but its venv looks broken (no venv/bin/pip) -- skipping pymc-companion self-update. Reinstall it manually (see docs/OPERATIONS.md)." >&2
        echo ""
      fi
    fi

    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true

      if [ -n "$2" ]; then
        # ── Upgrade: service was stopped by prerm; restart it ───────────────
        systemctl restart supply-drop-bbs.service || true
        echo ""
        echo "Supply Drop BBS upgraded and restarted."
        echo ""
      else
        # ── Fresh install: enable but don't start — run setup first ─────────
        systemctl enable supply-drop-bbs.service || true
        echo ""
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║              Supply Drop BBS installed                      ║"
        echo "╠══════════════════════════════════════════════════════════════╣"
        echo "║  1. Run the setup wizard to create your config:             ║"
        echo "║                                                              ║"
        echo "║       sudo supply-drop-bbs setup                            ║"
        echo "║                                                              ║"
        echo "║  2. Start the service:                                       ║"
        echo "║                                                              ║"
        echo "║       sudo systemctl start supply-drop-bbs                  ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        echo ""
      fi
    fi
    ;;
esac
